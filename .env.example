# Example only. Start with: node --env-file=.env scripts/selfhost.mjs
# Use a separate data directory for each development/staging/production instance.
NODE_ENV=production
WEB_PORT=4173
API_PORT=4174
RECEIVABLES_DATA_DIR=.data/selfhost
LOG_LEVEL=info

# Only when a trusted TLS reverse proxy/tunnel is configured. No trailing slash.
# PUBLIC_ORIGIN=https://receivables.example.com

# Docker Compose sets these; keep ordinary Mac startup loopback-only.
# CONTAINER_MODE=1
# WEB_BIND_HOST=0.0.0.0

# GATEWAY_TOKEN is generated by the supervisor. Never put it in the frontend.
# DATABASE_URL/OAuth/Redis are NOT active adapters; see docs/PRODUCTIZATION.md.
