{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "test": "node --import tsx --test tests/domain.test.ts tests/workbench.test.ts tests/templates.test.ts tests/project-lifecycle.test.ts",
    "test:unit": "node --import tsx --test tests/domain.test.ts tests/workbench.test.ts tests/templates.test.ts tests/project-lifecycle.test.ts",
    "verify": "node scripts/verify.mjs",
    "typecheck": "tsc --noEmit",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "api:build": "vite build --config apps/api/vite.config.ts",
    "gateway:build": "vite build --config apps/web-server/vite.config.ts",
    "selfhost:build": "node scripts/build-selfhost.mjs",
    "selfhost:init": "node .selfhost-build/api/admin.mjs init --generate",
    "selfhost:users": "node .selfhost-build/api/admin.mjs",
    "selfhost:backup": "node .selfhost-build/api/backup.mjs backup",
    "selfhost:restore": "node .selfhost-build/api/backup.mjs restore",
    "selfhost:start": "node scripts/selfhost.mjs",
    "selfhost:public": "node scripts/selfhost.mjs --public",
    "selfhost:stop": "node scripts/selfhost.mjs --stop",
    "selfhost:tunnel-install": "node scripts/install-cloudflared.mjs",
    "verify:selfhost": "node scripts/verify-selfhost.mjs",
    "test:adapter": "node --import tsx --test tests/node-adapter.test.ts",
    "test:node": "vite build --config apps/api/vite.config.ts --mode integrity-test && node scripts/run-integration-tests.mjs --node",
    "test:selfhost": "node --import tsx --test --test-concurrency=1 tests/selfhost.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
